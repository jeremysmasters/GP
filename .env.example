# SAP SuccessFactors demo tenant connection settings
# Copy this file to .env and fill in real values. Never commit .env.

# API host for your tenant's data center, no scheme, no trailing slash.
# Find it in Admin Center > Company System and Logo Settings > "API Login/Login Login URL"
# e.g. api4.successfactors.eu, api12.sapsf.com, apisalesdemo2.successfactors.com
SF_API_HOST=

# Admin Center > Company System and Logo Settings > "Company ID"
SF_COMPANY_ID=

# Admin Center > Manage OAuth2 Client Applications > your registered app > "API Key" / Client ID
SF_CLIENT_ID=

# The technical/API user this client acts as (an SF userId, not necessarily an email)
SF_API_USER_ID=

# Path to the PEM private key generated alongside the X.509 cert you registered
# with the OAuth client (SF's "Generate X.509 Certificate" tool downloads this once,
# at registration time -- it is not recoverable later, so store it securely).
SF_PRIVATE_KEY_PATH=./secrets/sf_private_key.pem

# Path to the matching PEM public certificate (same one uploaded/generated
# for the OAuth client registration).
SF_CERT_PATH=./secrets/sf_public_cert.pem
